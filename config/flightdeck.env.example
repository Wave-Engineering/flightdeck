# FlightDeck — example environment (S5.5 / #879).
#
# COPY to a real env file and fill in. This is a TEMPLATE — every secret value is
# a PLACEHOLDER. NEVER commit a real token. In Swarm the tokens come from Docker
# secrets (see deploy/flightdeck.stack.yml); this file documents every knob and is
# handy for a plain local `docker run --env-file` / `bun run`.

# ── Required ────────────────────────────────────────────────────────────────
# Shared bearer token the emitters present on POST /ingest. The server FAILS
# CLOSED (refuses to start) if this is unset. For a plain `docker run`, set it
# here; in Swarm, leave it unset and let the entrypoint read it from the secret
# file via FLIGHTDECK_INGEST_TOKEN_FILE instead.
FLIGHTDECK_INGEST_TOKEN=replace-me-with-a-long-random-token
# Swarm/Docker secret alternative (entrypoint reads this into the bare var above
# when the bare var is unset):
#FLIGHTDECK_INGEST_TOKEN_FILE=/run/secrets/flightdeck_ingest_token

# ── Network ─────────────────────────────────────────────────────────────────
# Port the service binds (0.0.0.0:PORT). Matches EXPOSE / the stack.
PORT=8080

# ── Persistent state (mount a volume at /data) ──────────────────────────────
# The append-only event log (source of truth) + the rebuildable SQLite view.
FLIGHTDECK_LOG_PATH=/data/events.jsonl
FLIGHTDECK_DB_PATH=/data/flightdeck.db

# ── Staleness watcher (optional; defaults shown) ────────────────────────────
# How often to re-scan for idle-but-incomplete activities.
FLIGHTDECK_WATCH_INTERVAL_MS=60000
# Age after which an activity with no terminal state is flagged stale (ms). 15m.
FLIGHTDECK_STALE_MS=900000

# ── Discord push (P4) — INERT unless BOTH channel + token are set ────────────
# Leave commented for no push. Set BOTH to alert on your phone when an activity
# goes stale. The container is the sole pusher (agent hosts stay outbound-only).
#FLIGHTDECK_DISCORD_CHANNEL=000000000000000000
#FLIGHTDECK_DISCORD_TOKEN=replace-me-with-a-bot-token
# Swarm/Docker secret alternative for the token:
#FLIGHTDECK_DISCORD_TOKEN_FILE=/run/secrets/flightdeck_discord_token
